# Application
APP_ENV=local
BANK_BACKEND_START_APPLICATION=true

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
BANK_BACKEND_HTTP_PORT=18080

# gRPC dependencies
GRPC_REPOSITORY_URL=localhost:50052
GRPC_EXCHANGE_RATE_URL=localhost:50053

# Six-digit bank identification number
CARD_BIN=537541

# Enable the backend Kafka producer. Set to false for local runs without Kafka.
KAFKA_ENABLED=true

# Comma-separated bootstrap brokers. The client discovers the full cluster
# after connecting to any available address.
KAFKA_BROKERS=localhost:39092,localhost:39093,localhost:39094

# Producer name written into every event envelope.
KAFKA_CLIENT_ID=bank-backend

# Backend-owned topic containing non-sensitive HTTP audit events.
KAFKA_AUDIT_TOPIC=bank.backend.audit.v1

# Number of partitions created for the backend audit topic.
KAFKA_TOPIC_PARTITIONS=3

# Number of Kafka brokers that store every partition replica.
# This must not exceed the number of available brokers.
KAFKA_TOPIC_REPLICATION_FACTOR=3

# Host ports exposed by the three Docker Compose Kafka brokers.
BANK_BACKEND_KAFKA_PORT=39092
BANK_BACKEND_KAFKA_2_PORT=39093
BANK_BACKEND_KAFKA_3_PORT=39094
