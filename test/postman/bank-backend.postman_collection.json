{
  "info": {
    "_postman_id": "19dd7489-efdc-46f7-9638-bankbackend",
    "name": "Bank Backend API",
    "description": "Repeatable integration tests. Creates isolated data, verifies API contracts, then removes the data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_id')) {",
          "  const runId = `${Date.now()}${Math.floor(Math.random() * 1000)}`;",
          "  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
          "  pm.collectionVariables.set('run_id', runId);",
          "  pm.collectionVariables.set('test_email', `postman.${runId}@example.test`);",
          "  pm.collectionVariables.set('test_phone', `+380${runId.slice(-9).padStart(9, '0')}`);",
          "  pm.collectionVariables.set('test_iso', 'T' + letters[Math.floor(Math.random() * 26)] + letters[Math.floor(Math.random() * 26)]);",
          "  pm.collectionVariables.set('test_symbol', String(9728 + Math.floor(Math.random() * 100)));",
          "}",
          "pm.variables.set('correlation_id', `postman-${pm.info.requestName}-${Date.now()}`);",
          "pm.variables.set('expected_status', 200);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = Number(pm.variables.get('expected_status'));",
          "pm.test(`Status code is ${expected}`, () => pm.response.to.have.status(expected));",
          "pm.test('Response time is below 5 seconds', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
          "if (pm.request.url.getPath() !== '/health') {",
          "  pm.test('Correlation ID is propagated', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(pm.variables.get('correlation_id')));",
          "}",
          "if (pm.response.text().length > 0) {",
          "  pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "run_id", "value": "" },
    { "key": "test_email", "value": "" },
    { "key": "test_phone", "value": "" },
    { "key": "test_iso", "value": "" },
    { "key": "test_symbol", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "currency_id", "value": "" },
    { "key": "account_id", "value": "" },
    { "key": "card_id", "value": "" },
    { "key": "credit_id", "value": "" },
    { "key": "deposit_id", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health and validation",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/health" },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Service reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"] }
          }]
        },
        {
          "name": "Reject invalid user",
          "event": [{
            "listen": "prerequest",
            "script": { "exec": ["pm.variables.set('expected_status', 400);"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/api/v1/users"
          }
        }
      ]
    },
    {
      "name": "02 Create workflow",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Runner\",\n  \"email\": \"{{test_email}}\",\n  \"phone_number\": \"{{test_phone}}\",\n  \"password_hash\": \"postman-password\"\n}"
            },
            "url": "{{base_url}}/api/v1/users"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Created user has an ID', () => pm.expect(body.id).to.be.a('number').above(0));",
              "pm.collectionVariables.set('user_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Create currency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman {{run_id}}\",\n  \"symbol\": {{test_symbol}},\n  \"iso_code\": \"{{test_iso}}\",\n  \"minor_units\": 2\n}"
            },
            "url": "{{base_url}}/api/v1/currencies"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Created currency has an ID', () => pm.expect(body.id).to.be.a('number').above(0));",
              "pm.collectionVariables.set('currency_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{user_id}},\n  \"currency_id\": {{currency_id}},\n  \"name\": \"Postman\"\n}" },
            "url": "{{base_url}}/api/v1/accounts"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Account references user', () => pm.expect(body.user_id).to.eql(Number(pm.collectionVariables.get('user_id'))));",
              "pm.collectionVariables.set('account_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Create card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{user_id}},\n  \"account_id\": {{account_id}}\n}" },
            "url": "{{base_url}}/api/v1/cards"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Card number is generated', () => pm.expect(body.number).to.match(/^\\d{16}$/));",
              "pm.collectionVariables.set('card_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Create credit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{user_id}},\n  \"currency_id\": {{currency_id}},\n  \"amount\": 5000,\n  \"term_months\": 12\n}" },
            "url": "{{base_url}}/api/v1/credits"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Credit is active', () => pm.expect(body.status).to.eql(1));",
              "pm.collectionVariables.set('credit_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Create deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": {{user_id}},\n  \"currency_id\": {{currency_id}},\n  \"amount\": 5000,\n  \"term_months\": 12\n}" },
            "url": "{{base_url}}/api/v1/deposits"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "pm.test('Deposit is active', () => pm.expect(body.status).to.eql(1));",
              "pm.collectionVariables.set('deposit_id', body.id);"
            ]}
          }]
        }
      ]
    },
    {
      "name": "03 Read and update workflow",
      "item": [
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Correct user returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('user_id'))));"] }
          }]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Updated\"\n}" },
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('User was updated', () => pm.expect(pm.response.json().first_name).to.eql('Updated'));"] }
          }]
        },
        {
          "name": "Update account",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlation_id}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated\"\n}" },
            "url": "{{base_url}}/api/v1/accounts/{{account_id}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Account was updated', () => pm.expect(pm.response.json().name).to.eql('Updated'));"] }
          }]
        },
        {
          "name": "Get cards by user",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/cards/user/{{user_id}}"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Card list is not empty', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"] }
          }]
        },
        {
          "name": "Repay credit",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/credits/{{credit_id}}/repay/100"
          }
        },
        {
          "name": "Replenish deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/deposits/{{deposit_id}}/replenish/100"
          }
        },
        {
          "name": "Block card",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/cards/{{card_id}}/block"
          }
        }
      ]
    },
    {
      "name": "04 Cleanup",
      "item": [
        {
          "name": "Delete card",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/cards/{{card_id}}" }
        },
        {
          "name": "Delete credit",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/credits/{{credit_id}}" }
        },
        {
          "name": "Delete deposit",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/deposits/{{deposit_id}}" }
        },
        {
          "name": "Delete account",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/accounts/{{account_id}}" }
        },
        {
          "name": "Delete currency",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/currencies/{{currency_id}}" }
        },
        {
          "name": "Delete user",
          "request": { "method": "DELETE", "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }], "url": "{{base_url}}/api/v1/users/{{user_id}}" }
        },
        {
          "name": "Deleted user returns 404",
          "event": [{
            "listen": "prerequest",
            "script": { "exec": ["pm.variables.set('expected_status', 404);"] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Correlation-ID", "value": "{{correlation_id}}" }],
            "url": "{{base_url}}/api/v1/users/{{user_id}}"
          }
        }
      ]
    }
  ]
}
